<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/editBusca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Buscar endereço..."
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"
            android:backgroundTint="@color/azul_localizacao"
            android:textColor="@color/white" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ou toque no mapa para marcar o local"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp" />

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="280dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtRaio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Raio: 300 metros"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekRaio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1900"
                android:progress="200" />

            <EditText
                android:id="@+id/editNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome do local (ex: Minha parada)"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quando o alarme deve tocar:"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <RadioGroup
                android:id="@+id/radioGroupModo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioTodos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="Todos os dias" />

                <RadioButton
                    android:id="@+id/radioSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="Dias de semana" />

                <RadioButton
                    android:id="@+id/radioHoje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="Só hoje" />

            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Só entre estes horários (opcional):"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnHorarioInicio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Início: 00:00"
                    android:backgroundTint="#333333"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnHorarioFim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Fim: 23:59"
                    android:backgroundTint="#333333"
                    android:textColor="@color/white" />

            </LinearLayout>

            <Button
                android:id="@+id/btnSalvarLocal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Salvar este local"
                android:backgroundTint="@color/azul_localizacao"
                android:textColor="@color/white" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
