<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toque no mapa para marcar o local"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:padding="12dp" />

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtRaio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raio: 300 metros"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekRaio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1900"
            android:progress="200" />

        <EditText
            android:id="@+id/editNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do local (ex: Minha parada)"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSalvarLocal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Salvar este local"
            android:backgroundTint="@color/azul_localizacao"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>
